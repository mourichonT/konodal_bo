# Un fichier par environnement, jamais commité (cf. .gitignore) :
# - .env.development : chargé par `npm run dev` / `npm run build:dev`
#   (config Web du projet Firebase konodal-dev)
# - .env.production  : chargé par `npm run build` / `npm run dev:prod`
#   (config Web du projet Firebase konodal-prod)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
